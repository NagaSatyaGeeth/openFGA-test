{
  "name": "openfga-rbac-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone OpenFGA RBAC evaluation app - role-based + per-individual access control over a VLS-Suite-shaped set of dummy modules. Throwaway demo, unrelated to any real VLS repo/infra.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "model:build": "node scripts/dsl2json.js openfga/model.fga openfga/model.json",
    "css:build": "tailwindcss -c tailwind.config.js -i src/tailwind-input.css -o public/vendor/tailwind.css --minify"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@openfga/syntax-transformer": "^0.2.2",
    "tailwindcss": "^3.4.16"
  }
}
